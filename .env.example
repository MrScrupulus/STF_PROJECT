# Copier ce fichier en .env et remplir les valeurs.
# NE JAMAIS commiter .env contenant de vrais secrets.
# Voir ENV_FILES.md pour le guide des fichiers .env

# --- Base de données (Docker / MariaDB) ---
MARIADB_ROOT_PASSWORD=votre_mot_de_passe_root
MARIADB_DATABASE=stf_db
MARIADB_USER=votre_utilisateur
MARIADB_PASSWORD=votre_mot_de_passe

# --- Symfony / Backend ---
APP_SECRET=generez_une_cle_aleatoire_32_caracteres

# --- Mailer (OVH MX Plan / webmail Zimbra) ---
# Le @ de l’adresse doit être écrit %40. Caractères spéciaux du mot de passe : URL-encode.
# Doc : https://help.ovhcloud.com/csm/fr-mx-plan-smtp
MAILER_DSN=smtps://noreply%40scrupy.com:MOT_DE_PASSE@smtp.mail.ovh.net:465
MAILER_FROM_EMAIL=noreply@scrupy.com

# --- URLs publiques ---
APP_BACKEND_URL=https://api.scrupy.com
APP_FRONTEND_URL=https://scrupy.com
EXPO_PUBLIC_API_URL=https://api.scrupy.com
NEXT_PUBLIC_API_URL=https://api.scrupy.com

# --- Chemins (optionnel) ---
# Dossier de stockage des photos. Par défaut : ./backend/data/uploads
# APP_UPLOADS_PATH=/chemin/absolu/vers/stock
