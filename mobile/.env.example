# Builds EAS : déjà défini dans eas.json
EXPO_PUBLIC_API_URL=https://api.scrupy.com

# Expo Go (dev) : sans cette variable, l'app utilise l'IP LAN (192.168.1.129:8001).
# Un Android hors Wi-Fi / sans cette IP ne pourra pas lister les compétitions ni l'historique.
# Ngrok n'est utile que pour le bundler Expo (--tunnel), pas pour l'API si vous pointez vers api.scrupy.com.
# Clé Maps SDK (Android APK). Ne pas committer la vraie clé.
# Restriction Google : package com.stf.mobile + SHA-1 EAS + Maps SDK for Android.
# EAS : eas env:set GOOGLE_MAPS_API_KEY --visibility sensitive --environment preview
# (sensitive plutôt que secret, pour que app.config.js la voie aussi en local au queue du build)
GOOGLE_MAPS_API_KEY=

