###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET={VOTRE_APP_SECRET}
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="mysql://{DB_USER}:{DB_PASSWORD}@database:3312/{DB_NAME}?serverVersion=mariadb-10.11.0"
###< doctrine/doctrine-bundle ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE={VOTRE_JWT_PASSPHRASE}
###< lexik/jwt-authentication-bundle ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1|scrupy\.com|www\.scrupy\.com|api\.scrupy\.com)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> symfony/mailer ###
# smtp.mail.ovh.net:465 (SSL). Encoder @ → %40 dans l’utilisateur.
MAILER_DSN=smtps://noreply%40scrupy.com:MOT_DE_PASSE@smtp.mail.ovh.net:465
MAILER_FROM_EMAIL=noreply@scrupy.com
###< symfony/mailer ###

###> URLs publiques (emails, photos, redirections) ###
APP_BACKEND_URL=https://api.scrupy.com
APP_FRONTEND_URL=https://scrupy.com
###< URLs publiques ###

###> Stockage des photos de prises ###
# Dossier de stockage des photos. Défaut : ./data/uploads (dans le projet).
# En production : chemin absolu ex. /home/mr_scrupulus/stock
# APP_UPLOADS_PATH=/home/mr_scrupulus/stock
###< Stockage des photos de prises ###